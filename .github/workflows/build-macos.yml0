name: Build wheels (macOS)

on:
  push:
    branches: [ "main", "dev" ]
  pull_request:

jobs:
  build-macos:
    runs-on: macos-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true

      - name: Cache Homebrew gcc
        uses: actions/cache@v4
        with:
          path: |
            /Users/runner/Library/Caches/Homebrew
            /opt/homebrew/Cellar/gcc
            /usr/local/Cellar/gcc
          key: ${{ runner.os }}-${{ runner.arch }}-homebrew-gcc-15
          restore-keys: |
            ${{ runner.os }}-${{ runner.arch }}-homebrew-gcc-

      - name: Install gfortran
        shell: bash
        run: |
          set -euxo pipefail

          brew update
          brew install gcc

          echo "Homebrew prefix:"
          brew --prefix

          echo "GCC prefix:"
          brew --prefix gcc

          echo "Available gfortran binaries:"
          ls -l "$(brew --prefix)/bin"/gfortran* || true
          ls -l "$(brew --prefix gcc)/bin"/gfortran* || true

          if [ -x "$(brew --prefix)/bin/gfortran-15" ]; then
            GFORTRAN="$(brew --prefix)/bin/gfortran-15"
          elif [ -x "$(brew --prefix gcc)/bin/gfortran-15" ]; then
            GFORTRAN="$(brew --prefix gcc)/bin/gfortran-15"
          elif command -v gfortran >/dev/null 2>&1; then
            GFORTRAN="$(command -v gfortran)"
          else
            echo "gfortran not found after brew install gcc" >&2
            exit 1
          fi

          echo "Using GFORTRAN=${GFORTRAN}"
          "${GFORTRAN}" --version

          mkdir -p "$RUNNER_TEMP/bin"
          ln -sf "${GFORTRAN}" "$RUNNER_TEMP/bin/gfortran"

          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
          echo "FC=${GFORTRAN}" >> "$GITHUB_ENV"
          echo "F77=${GFORTRAN}" >> "$GITHUB_ENV"
          echo "F90=${GFORTRAN}" >> "$GITHUB_ENV"

      - name: Build wheels (macOS)
        env:
          MACOSX_DEPLOYMENT_TARGET: "11.0"
        shell: bash
        run: |
          set -euxo pipefail

          echo "PATH=${PATH}"
          echo "FC=${FC}"
          command -v gfortran
          gfortran --version
          "${FC}" --version

          chmod +x scripts/topbuild_manywheel_macos_uv.sh scripts/build_wheel_macos.sh
          bash ./scripts/topbuild_manywheel_macos_uv.sh
          ls -lh dist

      - name: Upload wheels
        uses: actions/upload-artifact@v4
        with:
          name: wheels-macos
          path: dist/*.whl
          if-no-files-found: error
          retention-days: 14